{
  "version": 2,
  "crons": [
    { "path": "/api/cron-backtest-sync", "schedule": "*/15 * * * *" },
    { "path": "/api/run-pipeline?force=1", "schedule": "3 * * * *" },
    { "path": "/api/cron-signals", "schedule": "6,21,36,51 * * * *" }
  ],
  "functions": {
    "api/news-parse.js":          { "maxDuration": 30 },
    "api/run-pipeline.js":        { "maxDuration": 120 },
    "api/cron-backtest-sync.js":  { "maxDuration": 300 },
    "api/currency-comparison.js": { "maxDuration": 60 },
    "api/currency-chart.js":      { "maxDuration": 60 },
    "api/trade-signals.js":       { "maxDuration": 300 },
    "api/cron-signals.js":        { "maxDuration": 300 },
    "api/backfill-signals.js":    { "maxDuration": 300 },
    "api/backfill-m5.js":         { "maxDuration": 300 },
    "api/*-history.js":           { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/",       "destination": "/login.html" },
    { "source": "/home",   "destination": "/login.html" },
    { "source": "/app",    "destination": "/currency-comparison.html" },
    { "source": "/workspace", "destination": "/currency-comparison.html" },
    { "source": "/currency-comparison", "destination": "/currency-comparison.html" },
    { "source": "/comparison", "destination": "/currency-comparison.html" },
    { "source": "/trade-signals", "destination": "/trade-signals.html" },
    { "source": "/signals", "destination": "/trade-signals.html" },
    { "source": "/login",  "destination": "/login.html"   },
    { "source": "/setup",  "destination": "/setup.html"   },
    { "source": "/profile","destination": "/profile.html" },
    { "source": "/admin",   "destination": "/admin.html"   },
    { "source": "/journal",          "destination": "/journal.html" },
    { "source": "/payment-callback", "destination": "/payment-callback.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(app|workspace)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
