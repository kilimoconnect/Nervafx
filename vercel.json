{
  "version": 2,
  "crons": [
    { "path": "/api/cron-backtest-sync", "schedule": "0 * * * *" },
    { "path": "/api/run-pipeline?force=1", "schedule": "3 * * * *" },
    { "path": "/api/email-notify?type=digest", "schedule": "0 21 * * 1-5" }
  ],
  "functions": {
    "api/news-parse.js":          { "maxDuration": 30 },
    "api/run-pipeline.js":        { "maxDuration": 120 },
    "api/cron-backtest-sync.js":  { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/",       "destination": "/home.html" },
    { "source": "/home",   "destination": "/home.html" },
    { "source": "/app",    "destination": "/index.html"   },
    { "source": "/login",  "destination": "/login.html"   },
    { "source": "/setup",  "destination": "/setup.html"   },
    { "source": "/profile","destination": "/profile.html" },
    { "source": "/admin",   "destination": "/admin.html"   },
    { "source": "/journal",          "destination": "/journal.html" },
    { "source": "/payment-callback", "destination": "/payment-callback.html" },
    { "source": "/archive",          "destination": "/archive.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
