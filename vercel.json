{
  "version": 2,
  "crons": [
    { "path": "/api/cron-backtest-sync", "schedule": "1 * * * *" },
    { "path": "/api/run-pipeline?force=1", "schedule": "3 * * * *" }
  ],
  "functions": {
    "api/news-parse.js":          { "maxDuration": 30 },
    "api/run-pipeline.js":        { "maxDuration": 120 },
    "api/cron-backtest-sync.js":  { "maxDuration": 300 },
    "api/session-continuity.js":  { "maxDuration": 300 },
    "api/session-continuity-evolution.js": { "maxDuration": 60 },
    "api/currency-continuity.js": { "maxDuration": 60 },
    "api/structure-break.js":     { "maxDuration": 60 },
    "api/m15-quality.js":         { "maxDuration": 60 },
    "api/m15-energy.js":          { "maxDuration": 60 },
    "api/structure-engine.js":    { "maxDuration": 90 },
    "api/m15-strength-10c.js":    { "maxDuration": 60 },
    "api/h1-pair-moves.js":       { "maxDuration": 60 },
    "api/daily-raw-strength.js":  { "maxDuration": 120 },
    "api/m15-impulse.js": { "maxDuration": 60 },
    "api/currency-strength-*-ema.js": { "maxDuration": 30 },
    "api/currency-strength-m15-45m.js": { "maxDuration": 60 },
    "api/currency-state.js": { "maxDuration": 60 },
    "api/market-pressure.js": { "maxDuration": 120 },
    "api/pullback-tri-engine.js": { "maxDuration": 60 },
    "api/pullback-tri-h4-engine.js": { "maxDuration": 60 },
    "api/backfill-m5.js": { "maxDuration": 300 },
    "api/currency-stability.js": { "maxDuration": 30 },
    "api/*-history.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/",       "destination": "/login.html" },
    { "source": "/home",   "destination": "/login.html" },
    { "source": "/app",    "destination": "/index.html" },
    { "source": "/m15-intelligence", "destination": "/m15-intelligence.html" },
    { "source": "/login",  "destination": "/login.html"   },
    { "source": "/setup",  "destination": "/setup.html"   },
    { "source": "/profile","destination": "/profile.html" },
    { "source": "/admin",   "destination": "/admin.html"   },
    { "source": "/journal",          "destination": "/journal.html" },
    { "source": "/payment-callback", "destination": "/payment-callback.html" },
    { "source": "/session-continuity", "destination": "/session-continuity.html" },
    { "source": "/currency-continuity", "destination": "/currency-continuity.html" },
    { "source": "/structure-break", "destination": "/structure-break.html" },
    { "source": "/m15-quality", "destination": "/m15-quality.html" },
    { "source": "/daily-strength", "destination": "/daily-strength.html" },
    { "source": "/m15-impulse", "destination": "/m15-impulse.html" },
    { "source": "/currency-strength-m15", "destination": "/currency-strength-m15.html" },
    { "source": "/currency-state", "destination": "/currency-state.html" },
    { "source": "/market-pressure", "destination": "/market-pressure.html" },
    { "source": "/pullback-tri-engine", "destination": "/pullback-tri-engine.html" },
    { "source": "/pullback-tri-h4-engine", "destination": "/pullback-tri-h4-engine.html" },
    { "source": "/currency-stability", "destination": "/currency-stability.html" },
    { "source": "/mtre", "destination": "/mtre.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(app|m15-intelligence)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
